<!DOCTYPE html>
<html language="en">
<head>
  <title>Student</title>
  <%- include('./partials/style'); %>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <%- include('./partials/header'); %>
    <!-- Content -->
    <h1>List of <%= studentJSON.length %> students</h1>
    <% for(let r=0; r<studentJSON.length/EACH_ROW; r++){ %>
      <div class="row p-3">
      <% for(let c=0; c<EACH_ROW; c++) {%>
        <% let idx=r*EACH_ROW+c;
        if(idx<studentJSON.length) { %>
          <div class="col-sm-4">
            <div class="card">
              <div class="card-header bg-primary text-white">
                Student #<%= idx %>
              </div>
              <div class="card-body">
                <h5 class="card-title"><%= studentJSON[idx]["firstname"] %> <%= studentJSON[idx]["lastname"] %></h5>
                <p class="card-text">
                  Age: <%= studentJSON[idx]["age"] %>
                  <br />
                  e-mail:
                  <br />
                  <%= studentJSON[idx]["email"] %>
                </p>
              </div>
            </div>
          </div>
        <% } %>
      <% } %>
      </div>
    <% } %>
    <!-- Footer -->
    <%- include('./partials/footer'); %>
  </div>
</body>
</html>